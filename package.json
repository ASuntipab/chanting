{
  "name": "chant-app",
  "version": "1.0.0",
  "description": "Chant: บทสวดมนต์ - Daily Buddhist Chanting & Prayer Companion App",
  "main": "tamma.html",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "icons:generate": "python scripts/generate_app_icons.py",
    "test": "node --test tests/*.test.js",
    "cap:build": "npm run build && npx cap sync",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run build && npx cap run android",
    "cap:run:ios": "npm run build && npx cap run ios"
  },
  "keywords": [
    "dharma",
    "prayers",
    "ebook",
    "comic-reader",
    "chanting",
    "buddhism",
    "capacitor"
  ],
  "author": "Kai Soft / Antigravity",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0"
  }
}
